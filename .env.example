# Copy to .env and adjust. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me
APP_NAME=1000 Doors

# Supabase (Milestone 4). Settings > API Keys and the Connect dialog in the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Session pooler connection string, used to run migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
